<UserControl x:Class="Zyrox.Pages.WorldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextMain}">
    <DockPanel Margin="40,16,40,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock Text="Worlds" Style="{StaticResource PageTitle}"/>
            <TextBlock x:Name="Hint" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="WorldList"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
