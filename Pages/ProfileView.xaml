<UserControl x:Class="Zyrox.Pages.ProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:Zyrox.Pages"
             Foreground="{StaticResource TextMain}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: icon, name, chips, stats, play -->
        <Border Background="#99100C0E" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="28,22,28,18">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Width="44" Height="48" Padding="0" Margin="0,0,8,0"
                            ToolTip="Open folder" Click="OnFolderClick">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                    </Button>
                    <Button x:Name="ExportButton" Style="{StaticResource GhostButton}" Width="44" Height="48" Padding="0" Margin="0,0,8,0"
                            ToolTip="Export profile" Click="OnExportClick">
                        <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                    </Button>
                    <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Width="170" Height="48" FontSize="20" Click="OnPlayClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xF5B0;" FontFamily="{StaticResource Icons}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,2"/>
                            <TextBlock Text="PLAY" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GhostButton}" Width="44" Height="48" Padding="0" Margin="8,0,0,0"
                            ToolTip="Profile settings" Click="OnSettingsClick">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="16"/>
                    </Button>
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="IconTile" Width="76" Height="76" Margin="0,0,18,0" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="IconPop"/>
                            </Grid.RenderTransform>
                            <Border Background="#E61A0E12" CornerRadius="4"/>
                            <Border Background="{DynamicResource Accent}" Opacity="0.2" CornerRadius="4"/>
                            <Border BorderBrush="{DynamicResource Accent}" BorderThickness="1,1,1,3" CornerRadius="4"/>
                            <TextBlock x:Name="IconGlyph" Text="&#xE7B8;" FontFamily="{StaticResource Icons}" FontSize="32"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="NameText" FontFamily="{StaticResource Heading}" FontSize="34" TextTrimming="CharacterEllipsis"/>
                            <WrapPanel x:Name="Chips" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="Stats" Orientation="Horizontal" Margin="0,16,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <!-- Content of the chosen tab -->
            <Grid x:Name="Body">
                <pages:ModsPage x:Name="ModsView" Visibility="Collapsed"/>
                <pages:WorldsPage x:Name="WorldsView" Visibility="Collapsed"/>
                <pages:ServersPage x:Name="ServersView" Visibility="Collapsed"/>
                <pages:GalleryPage x:Name="GalleryView" Visibility="Collapsed"/>
                <ScrollViewer x:Name="ClientView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ClientPanel" Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left"/>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <ContentControl x:Name="SettingsHost" Margin="28,20,28,24" MaxWidth="640" HorizontalAlignment="Left"/>
                </ScrollViewer>
            </Grid>

            <!-- Section sidebar -->
            <Border Grid.Column="1" Background="#99100C0E" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,16">
                        <TextBlock Text="CONTENT" Style="{StaticResource SideHeader}"/>
                        <RadioButton x:Name="ModsTab" Style="{StaticResource SideTab}" Tag="&#xEA86;" Content="MODS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="PacksTab" Style="{StaticResource SideTab}" Tag="&#xE790;" Content="RESOURCE PACKS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="ShadersTab" Style="{StaticResource SideTab}" Tag="&#xE706;" Content="SHADER PACKS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="ModpacksTab" Style="{StaticResource SideTab}" Tag="&#xE7B8;" Content="MODPACKS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="ClientTab" Style="{StaticResource SideTab}" Tag="&#xE945;" Content="ZYROX CLIENT" Checked="OnTabChecked"/>

                        <TextBlock Text="WORLD" Style="{StaticResource SideHeader}" Margin="8,18,0,6"/>
                        <RadioButton x:Name="WorldsTab" Style="{StaticResource SideTab}" Tag="&#xE909;" Content="WORLDS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="ServersTab" Style="{StaticResource SideTab}" Tag="&#xE968;" Content="SERVERS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="GalleryTab" Style="{StaticResource SideTab}" Tag="&#xEB9F;" Content="SCREENSHOTS" Checked="OnTabChecked"/>
                        <RadioButton x:Name="LogsTab" Style="{StaticResource SideTab}" Tag="&#xE9F9;" Content="LOGS" Click="OnLogsClick" GroupName="Logs"/>

                        <TextBlock Text="PROFILE" Style="{StaticResource SideHeader}" Margin="8,18,0,6"/>
                        <RadioButton x:Name="SettingsTab" Style="{StaticResource SideTab}" Tag="&#xE713;" Content="SETTINGS" Checked="OnTabChecked"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
