<UserControl x:Class="Zyrox.Pages.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextMain}">
    <Grid Margin="40,16,40,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <TextBlock Text="Servers" Style="{StaticResource PageTitle}"/>
                <TextBlock x:Name="Hint" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ServerList"/>
            </ScrollViewer>
        </DockPanel>
        <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Add server" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,14"/>
                <TextBlock Text="Name (optional)" Margin="0,0,0,6"/>
                <TextBox x:Name="NameBox" Margin="0,0,0,14"/>
                <TextBlock Text="Address" Margin="0,0,0,6"/>
                <TextBox x:Name="AddressBox" Margin="0,0,0,18" AutomationProperties.AutomationId="ServerAddress"/>
                <Button Content="Add" Height="42" FontSize="14" Style="{StaticResource PlayButton}" Click="OnAddClick"/>
                <TextBlock x:Name="AddStatus" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
