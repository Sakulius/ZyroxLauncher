<UserControl x:Class="Zyrox.Pages.SkinsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Zyrox.Controls"
             Foreground="{StaticResource TextMain}">
    <Grid Margin="40,16,40,24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                <TextBlock x:Name="PreviewName" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12" Height="32">
                    <RadioButton x:Name="ClassicBox" Content="Wide arms" GroupName="SkinModel" Style="{StaticResource NavTab}" Checked="OnModelChanged"/>
                    <RadioButton x:Name="SlimBox" Content="Slim arms" GroupName="SkinModel" Style="{StaticResource NavTab}" Checked="OnModelChanged"/>
                </StackPanel>
                <Button x:Name="ApplyButton" Content="Apply to my account" Height="44" FontSize="14" Style="{StaticResource PlayButton}" Click="OnApplyClick"/>
                <TextBlock x:Name="ApplyStatus" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
            <controls:SkinViewer x:Name="Preview"/>
        </DockPanel>

        <DockPanel Grid.Column="2">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Save current skin" Style="{StaticResource GhostButton}" Click="OnSaveCurrentClick"/>
                    <Button Content="Add skin" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="OnAddClick"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="Skins" Style="{StaticResource PageTitle}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Your collection. Click a skin to preview it."/>
                </StackPanel>
            </DockPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <WrapPanel x:Name="Library"/>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
