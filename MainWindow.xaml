<Window x:Class="Zyrox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Zyrox.Controls"
        xmlns:pages="clr-namespace:Zyrox.Pages"
        Title="Zyrox" Width="1240" Height="760" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Icon="Assets/zyrox.ico"
        Background="#100C0E" Foreground="{StaticResource TextMain}" FontFamily="{StaticResource Body}" FontSize="14"
        Loaded="OnLoaded" Closing="OnClosing" StateChanged="OnStateChanged"
        Activated="OnActivationChanged" Deactivated="OnActivationChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="1" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root" ClipToBounds="True" Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.985" ScaleY="0.985"/>
        </Grid.RenderTransform>

        <!-- Background image with blur, parallax and a soft copy for sub pages -->
        <Grid Margin="-48" IsHitTestVisible="False">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="BackgroundShift"/>
            </Grid.RenderTransform>
            <Grid>
                <Grid.Effect>
                    <BlurEffect x:Name="BackgroundBlur" Radius="0" RenderingBias="Performance"/>
                </Grid.Effect>
                <Image x:Name="BackgroundA" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="BackgroundB" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
            </Grid>
            <Image x:Name="BackgroundSoft" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                   RenderOptions.BitmapScalingMode="Linear"/>
        </Grid>
        <!-- dark at the top and bottom so text stays readable -->
        <Rectangle IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99000000" Offset="0"/>
                    <GradientStop Color="#22000000" Offset="0.2"/>
                    <GradientStop Color="#22000000" Offset="0.55"/>
                    <GradientStop Color="#D9000000" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle x:Name="ThemeTint" Fill="{DynamicResource Accent}" Opacity="0.05" IsHitTestVisible="False"/>
        <Rectangle x:Name="PageScrim" Fill="#B3000000" Opacity="0" IsHitTestVisible="False"/>

        <Grid Margin="84,44,0,0">
            <!-- Home: launch column on the left, the player in the right column -->
            <Grid x:Name="HomePage" Margin="20,8,20,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse x:Name="PlayerShadow" Grid.Column="2" Width="160" Height="70" Margin="-150,0,0,-6" VerticalAlignment="Bottom"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#78000000" Offset="0"/>
                            <GradientStop Color="#00000000" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <controls:SkinViewer x:Name="Avatar" Grid.Column="2" Margin="-150,30,0,10"/>

                <CheckBox x:Name="SkinAnimToggle" Grid.Column="2" Content="Skin animation" Style="{StaticResource ToggleSwitch}"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,0,0"
                          Checked="OnSkinAnimToggled" Unchecked="OnSkinAnimToggled"/>

                <Grid Width="460" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="84"/>
                    </Grid.RowDefinitions>

                    <StackPanel x:Name="NameTag" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,14"
                                RenderTransformOrigin="0.5,0.5">
                        <StackPanel.LayoutTransform>
                            <ScaleTransform x:Name="NameTagScale"/>
                        </StackPanel.LayoutTransform>
                        <Grid x:Name="NameHead" Width="26" Height="26" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Image x:Name="NameHeadBase"/>
                            <Image x:Name="NameHeadOverlay"/>
                        </Grid>
                        <TextBlock x:Name="PlayerName" FontWeight="SemiBold" FontSize="24" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Grid x:Name="LaunchBar" Grid.Row="2" Width="400" Height="72" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" FontSize="24" Click="OnPlayClick"
                                AutomationProperties.AutomationId="PlayButton"/>
                        <ComboBox x:Name="ProfileBox" Grid.Column="2" Style="{StaticResource ArrowCombo}" SelectionChanged="OnProfileChanged"
                                  ToolTip="Select profile"/>
                        <Border x:Name="ProgressTrack" Grid.ColumnSpan="3" Height="3" VerticalAlignment="Bottom" Background="#28FFFFFF" Visibility="Collapsed">
                            <ProgressBar x:Name="Progress" Minimum="0" Maximum="1" Foreground="White"/>
                        </Border>
                    </Grid>

                    <StackPanel x:Name="StatusPanel" Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,14,0,0">
                        <TextBlock x:Name="ProgressDetail" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,0,0,4" Visibility="Collapsed"/>
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" FontSize="13.5"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="UpdateButton" Style="{StaticResource GhostButton}" Margin="4,8,4,0" Padding="10,5" Visibility="Collapsed" Click="OnInstallUpdateClick"/>
                            <Button x:Name="LogsButton" Content="Open logs" Style="{StaticResource GhostButton}" Margin="4,8,4,0"
                                    Padding="10,5" Visibility="Collapsed" Click="OnLogsClick"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>

            <pages:ProfilesPage x:Name="ProfilesView" Visibility="Collapsed"/>
            <pages:ProfileView x:Name="ProfileView" Visibility="Collapsed"/>
            <pages:SkinsPage x:Name="SkinsView" Visibility="Collapsed"/>
            <pages:SettingsPage x:Name="SettingsView" Visibility="Collapsed"/>
        </Grid>

        <!-- Top bar: logo tile and brand, account button, settings gear, window buttons -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Height="44">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="OnCloseClick" Width="46" Height="44"
                        ToolTip="Close" AutomationProperties.AutomationId="CloseButton"/>
                <Button x:Name="MaximizeButton" DockPanel.Dock="Right" Content="&#xE922;" Style="{StaticResource WindowButton}" Width="46" Height="44"
                        Click="OnMaximizeClick" ToolTip="Maximize"/>
                <Button DockPanel.Dock="Right" Content="&#xE921;" Style="{StaticResource WindowButton}" Width="46" Height="44"
                        Click="OnMinimizeClick" ToolTip="Minimize"/>

                <RadioButton x:Name="SettingsTab" DockPanel.Dock="Right" GroupName="Nav" Style="{StaticResource NavTab}" Height="44" Margin="0,0,4,0"
                             Checked="OnNavChecked" ToolTip="Settings" AutomationProperties.AutomationId="SettingsTab">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Icons}" FontSize="15"/>
                </RadioButton>

                <Button x:Name="AccountsButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Background="Transparent" Padding="6,5,12,5"
                        Height="32" Click="OnAccountClick" WindowChrome.IsHitTestVisibleInChrome="True" AutomationProperties.AutomationId="AccountsButton">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="22" Height="22" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Border Background="#33FFFFFF" CornerRadius="3"/>
                            <Image x:Name="HeadBase"/>
                            <Image x:Name="HeadOverlay"/>
                        </Grid>
                        <TextBlock x:Name="AccountName" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Margin="8,0,8,0"/>
                        <Ellipse x:Name="OnlineDot" Width="7" Height="7" Fill="#3DDC84" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Border Width="20" Height="20" CornerRadius="5" Background="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="LogoScale"/>
                        </Border.RenderTransform>
                        <TextBlock Text="Z" FontWeight="SemiBold" FontSize="13" Foreground="#1A080B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="ZYROX" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Button x:Name="BackButton" Content="&#xE76B;" Style="{StaticResource WindowButton}" Width="32" Height="32" FontSize="12"
                            Margin="16,0,0,0" Visibility="Collapsed" Click="OnBackClick" ToolTip="Back"/>
                </StackPanel>
            </DockPanel>
        </Grid>

        <!-- Start notice: beta look, online features off, work in progress -->
        <Grid x:Name="BetaNotice" Panel.ZIndex="10" Visibility="Collapsed">
            <Rectangle x:Name="BetaScrim" Fill="#B4000000" Opacity="0"/>
            <Grid x:Name="BetaCard" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <ScaleTransform x:Name="BetaCardScale"/>
                </Grid.RenderTransform>
                <Border Background="{DynamicResource Accent}" Opacity="0.18" Margin="-30" CornerRadius="60">
                    <Border.Effect>
                        <BlurEffect Radius="80" RenderingBias="Performance"/>
                    </Border.Effect>
                </Border>
                <Border Style="{StaticResource Card}" Padding="0"/>
                <StackPanel Margin="28,26,28,24">
                    <StackPanel Orientation="Horizontal">
                        <Border Background="{DynamicResource Accent}" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                            <TextBlock Text="BETA" FontWeight="SemiBold" FontSize="12" Foreground="#1A080B"/>
                        </Border>
                        <TextBlock Text="Heads up!" FontWeight="SemiBold" FontSize="22" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Margin="0,22,0,0">
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="&#xE9CE;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,1,12,0"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#E0D4D8" FontSize="13.5">
                                <Run FontWeight="SemiBold" Foreground="White">The new look is a beta.</Run> Things may still change, move around or look a bit rough.
                            </TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Left" Text="&#xF384;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,1,12,0"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#E0D4D8" FontSize="13.5">
                                <Run FontWeight="SemiBold" Foreground="White">Online features are turned off</Run> for now. They will come back later.
                            </TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="&#xE90F;" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Accent}" Margin="0,1,12,0"/>
                            <TextBlock TextWrapping="Wrap" Foreground="#E0D4D8" FontSize="13.5">
                                <Run FontWeight="SemiBold" Foreground="White">The launcher is under construction.</Run> I am working on it, so expect bugs and missing parts.
                            </TextBlock>
                        </DockPanel>
                    </StackPanel>
                    <Button Content="GOT IT" Style="{StaticResource PlayButton}" Height="42" FontSize="15" Margin="0,22,0,0" Click="OnBetaNoticeClose"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Floating sidebar with a sliding selection box -->
        <Grid x:Name="Rail" HorizontalAlignment="Left" VerticalAlignment="Top" Width="76" Margin="12,52,0,0">
            <Border Background="#EE100C0E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"/>

            <Border x:Name="RailIndicator" VerticalAlignment="Top" Height="64" Margin="6,0" Opacity="0" IsHitTestVisible="False"
                    Background="{StaticResource FieldHover}" CornerRadius="10">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="RailIndicatorShift"/>
                </Border.RenderTransform>
            </Border>

            <StackPanel x:Name="RailTabs" Margin="6,6,6,0">
                <RadioButton x:Name="HomeTab" GroupName="Nav" Style="{StaticResource RailTab}" Tag="Home" Checked="OnNavChecked" IsChecked="True">
                    <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Icons}" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="ProfilesTab" GroupName="Nav" Style="{StaticResource RailTab}" Tag="Profiles" Checked="OnNavChecked">
                    <TextBlock Text="&#xE8FD;" FontFamily="{StaticResource Icons}" FontSize="18"/>
                </RadioButton>
                <RadioButton x:Name="SkinsTab" GroupName="Nav" Style="{StaticResource RailTab}" Tag="Skins" Checked="OnNavChecked"
                             AutomationProperties.AutomationId="SkinsButton">
                    <Viewbox Width="18" Height="18">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                              Data="M8,2 L4.5,3.2 L0.5,7.5 L4,11 L6,9 L6,22 L18,22 L18,9 L20,11 L23.5,7.5 L19.5,3.2 L16,2 C15,5 9,5 8,2 Z"/>
                    </Viewbox>
                </RadioButton>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
